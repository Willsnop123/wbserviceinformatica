---
/**
 * Hero.
 *
 * Tres bloques: titulo, una linea y un boton. Lo que antes eran siete.
 *
 * Sin cuadricula ni marca de fondo: el titulo no comparte la pantalla con
 * nada. El unico elemento que se mueve es el indicador de scroll, y se
 * mueve porque su trabajo es decir "hay mas abajo".
 */
---

<section class="hero" data-screen-label="Hero">

  <div class="hero-inner">
    <h1>
      Servicio técnico de<br />
      <span class="accent">informática y consolas.</span>
    </h1>

    <p class="hero-desc">
      PC, notebooks, PlayStation, Xbox y joysticks en Gualeguay.
      Atención directa, con turno previo.
    </p>

    <a
      class="btn-wa hero-cta"
      href="https://wa.me/5493444569948?text=Hola!%20Quiero%20consultar"
      target="_blank"
      rel="noopener"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
      Reservar turno
    </a>
  </div>

  <!-- Sin texto: una linea por la que baja una luz, en loop. -->
  <div class="scroll-hint" aria-hidden="true">
    <span class="rail"></span>
  </div>
</section>

<div class="trust-band">
  <div class="trust-inner">
    <span>Turno en 24 hs</span>
    <span>Presupuesto sin cargo</span>
    <span>Seguimiento por WhatsApp</span>
    <span>Garantía en el trabajo</span>
  </div>
</div>
