---
import CtaBoton from '../layout/CtaBoton.astro';
/**
 * Hero.
 *
 * Tres bloques: titulo, una linea y un boton. Lo que antes eran siete.
 *
 * Sin cuadricula ni marca de fondo: el titulo no comparte la pantalla con
 * nada. El unico elemento que se mueve es el indicador de scroll, y se
 * mueve porque su trabajo es decir "hay mas abajo".
 */
---

<section class="hero" data-screen-label="Hero">

  <div class="hero-inner">
    <h1>
      Servicio técnico de<br />
      <span class="accent">informática y consolas.</span>
    </h1>

    <p class="hero-desc">
      PC, notebooks, PlayStation, Xbox y joysticks en Gualeguay.
      Atención directa, con turno previo.
    </p>

    <CtaBoton
      href="https://wa.me/5493444569948?text=Hola!%20Quiero%20consultar"
      texto="Reservar turno"
      variante="wa"
      icono="wa"
      externo
      grande
      clase="hero-cta"
    />
  </div>

  <!-- Sin texto: una linea por la que baja una luz, en loop. -->
  <div class="scroll-hint" aria-hidden="true">
    <span class="rail"></span>
  </div>
</section>

<div class="trust-band">
  <div class="trust-inner">
    <span>Turno en 24 hs</span>
    <span>Presupuesto sin cargo</span>
    <span>Seguimiento por WhatsApp</span>
    <span>Garantía en el trabajo</span>
  </div>
</div>
