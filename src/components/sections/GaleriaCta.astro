<section class="galeria-cta" id="galeria" data-screen-label="06 Galería">
  <div class="galeria-inner">

    <div class="galeria-text" data-fade>
      <div class="kicker"><span class="bar"></span> Trabajos reales</div>
      <h2>El trabajo<br/>habla solo.</h2>
      <p>Deslizá la imagen y mirá la diferencia. Cada reparación queda documentada — entrar a la galería y ver todos los casos.</p>
      <div class="gal-stats">
        <div><div class="gal-stat-n">PC</div><div class="gal-stat-l">Notebooks y desktop</div></div>
        <div><div class="gal-stat-n">PS3·4·5</div><div class="gal-stat-l">PlayStation</div></div>
        <div><div class="gal-stat-n">100%</div><div class="gal-stat-l">Casos reales</div></div>
      </div>
      <a class="btn-blue" href="/galeria/">
        Ver galería completa →
      </a>
    </div>

    <!-- Comparador antes / después interactivo -->
    <div class="compare-widget" data-compare>
      <!-- Imagen base: ANTES -->
      <img class="cw-img" src="/imagenes/pc-antes.webp" alt="PC antes de la limpieza" draggable="false" loading="lazy" decoding="async"/>
      <!-- Imagen superior: DESPUÉS, recortada por clip-path -->
      <div class="cw-after">
        <img class="cw-img" src="/imagenes/pc-despues.webp" alt="PC después de la limpieza" draggable="false" loading="lazy" decoding="async"/>
      </div>
      <!-- Divisor con knob -->
      <div class="cw-divider">
        <div class="cw-line"></div>
        <div class="cw-knob">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 9l-4 3 4 3M17 9l4 3-4 3"/>
          </svg>
        </div>
        <div class="cw-line"></div>
      </div>
      <!-- Badges -->
      <span class="cw-badge cw-badge-before">Antes</span>
      <span class="cw-badge cw-badge-after">Después</span>
      <!-- Hint inicial -->
      <div class="cw-hint">← deslizá →</div>
    </div>

  </div>
</section>
