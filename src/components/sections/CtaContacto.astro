---
import CtaBoton from '../layout/CtaBoton.astro';

interface Props {
  titulo?: string;
  texto?: string;
  mensaje?: string;
}

const {
  titulo = 'Contame qué le pasa.',
  texto = 'Escribime por WhatsApp con el modelo del equipo y el problema. Te paso el diagnóstico y el presupuesto antes de tocar nada.',
  mensaje = 'Hola! Quiero consultar',
} = Astro.props;

const wa = `https://wa.me/5493444569948?text=${encodeURIComponent(mensaje)}`;
---

<section class="cta-band" data-screen-label="Contacto">
  <div class="cta-band-inner" data-fade>
    <div class="kicker"><span class="bar"></span> Turno por WhatsApp</div>
    <h2>{titulo}</h2>
    <p>{texto}</p>
    <div class="cta-band-btns">
      <CtaBoton href={wa} texto="Reservar turno ahora" variante="wa" icono="wa" externo grande />
      <CtaBoton href="/galeria/" texto="Ver trabajos hechos" variante="borde" grande />
    </div>
  </div>
</section>
