---
/**
 * Servicios, en paneles diagonales.
 *
 * Reemplaza a la grilla de cuatro tarjetas con icono. La grilla cumplia,
 * pero no mostraba nada: cuatro rectangulos iguales con un dibujito adentro
 * podrian ser los de cualquier taller del pais.
 *
 * Estos paneles van en diagonal y cada uno lleva una imagen propia: un
 * disipador de cobre, el blanco de una consola encontrandose con una
 * rejilla verde, un analogico con estelas de movimiento, una fila de
 * ventiladores. El que recibe el puntero se agranda, empuja a los demas y
 * revela su descripcion, mientras la imagen se acerca.
 *
 * Los originales viven en recursos/imagenes-originales/, fuera de public/
 * porque pesan ocho veces mas que lo que necesita el visitante. El LEEME
 * de esa carpeta tiene el recorte exacto de cada una.
 *
 * El sesgo se hace con `skew` sobre la banda y el inverso sobre el interior
 * de cada panel: asi el borde queda en diagonal pero la foto y el texto
 * siguen derechos. Sesgando la foto, saldria deformada.
 */
import { versionado } from '../../lib/version';

/* Las fotos llevan el hash de su contenido pegado a la URL.
   Sin eso, cambiar una imagen conservando el nombre no llega a nadie: el
   navegador ya tiene esa URL guardada y sigue mostrando la anterior.
   Paso con estas cuatro — el archivo nuevo estaba publicado y la pagina
   seguia mostrando las viejas. */
const servicios = [
  {
    href: '/pc-y-notebooks/',
    titulo: 'PC y Notebooks',
    texto: 'Limpieza profunda, pasta térmica, cambio de componentes y diagnóstico completo de escritorio y portátiles.',
    foto: versionado('/imagenes/servicio-pc.webp'),
    alt: 'Disipador de cobre sobre la placa de una computadora, en primer plano',
  },
  {
    href: '/consolas/',
    titulo: 'PlayStation y Xbox',
    texto: 'PS3, PS4, PS5, Xbox 360, One y Series. Limpieza, HDMI roto, lector de disco y sobrecalentamiento.',
    foto: versionado('/imagenes/servicio-consolas.webp'),
    alt: 'Superficie blanca de una consola junto a una rejilla negra con luz verde saliendo de adentro',
  },
  {
    href: '/joysticks/',
    titulo: 'Joysticks con drift',
    texto: 'Cambio de joystick analógico, botones y calibración. Con prueba antes de devolvértelo.',
    foto: versionado('/imagenes/servicio-joysticks.webp'),
    alt: 'Analógico de un joystick en primer plano, con estelas de luz girando a su alrededor',
  },
  {
    href: '/comercios/',
    titulo: 'Planes para comercios',
    texto: 'Mantenimiento preventivo mensual para negocios de Gualeguay, con soporte prioritario.',
    foto: versionado('/imagenes/servicio-comercios.webp'),
    alt: 'Fila de ventiladores idénticos alineados, perdiéndose en la profundidad',
  },
];
---

<section class="porque servicios-diag" id="servicios" data-screen-label="01 Servicios">
  <div class="porque-inner">
    <div class="porque-head">
      <div class="kicker"><span class="bar"></span> Servicios</div>
      <h2>Qué reparamos<br /><span class="accent">en el taller.</span></h2>
      <p>Cada servicio tiene su página con el detalle de lo que incluye y cómo trabajamos.</p>
    </div>

    <div class="sd-banda">
      {servicios.map((s, i) => (
        <a class="sd-panel" href={s.href} data-fade style={`--orden:${i}`}>
          <div class="sd-recto">
            <img
              class="sd-foto"
              src={s.foto}
              alt={s.alt}
              width="1000"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <div class="sd-velo"></div>
            {/* h3 y p de verdad: son los nombres de los servicios y el
                detalle de cada uno, y asi los lee Google igual que antes
                con las tarjetas. */}
            <div class="sd-texto">
              <span class="sd-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="sd-titulo">{s.titulo}</h3>
              <p class="sd-desc">{s.texto}</p>
              <span class="sd-mas">
                Ver detalle
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
