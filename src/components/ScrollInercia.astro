---
/**
 * Scroll con inercia para el ala de servicio tecnico.
 *
 * WB Code ya lo tiene desde adentro de React (hook useLenis). Esta es la
 * version para las paginas .astro, que no montan React.
 *
 * Tres cosas que hay que respetar si se toca:
 *
 * 1. Con navegacion sin recarga la instancia vieja queda viva apuntando a un
 *    DOM que ya no existe. Se destruye en cada cambio de pagina.
 * 2. En /code no se instancia: ese lado ya tiene la suya y dos motores
 *    peleando por el scroll dan saltos.
 * 3. Quien pidio menos movimiento no quiere que le secuestren el scroll.
 */
---

<script>
  import Lenis from 'lenis';

  let lenis: Lenis | null = null;
  let raf = 0;

  function destruir() {
    if (raf) cancelAnimationFrame(raf);
    raf = 0;
    lenis?.destroy();
    lenis = null;
  }

  function arrancar() {
    destruir();

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // El ala de WB Code monta la suya desde React.
    if (document.documentElement.dataset.world === 'code') return;

    lenis = new Lenis({
      duration: 1.05,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      wheelMultiplier: 0.9,
      touchMultiplier: 1.6,
    });

    const tick = (t: number) => {
      lenis?.raf(t);
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  }

  document.addEventListener('astro:page-load', arrancar);
  document.addEventListener('astro:before-swap', destruir);
</script>
