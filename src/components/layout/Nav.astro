---
import CtaBoton from './CtaBoton.astro';

interface Props {
  active?: string;
}
const { active } = Astro.props;

const links = [
  { key: 'servicios', href: '/#servicios', label: 'Servicios' },
  { key: 'galeria', href: '/galeria/', label: 'Galería de trabajos' },
  { key: 'nosotros', href: '/#sobre', label: 'Nosotros' },
];
---

{/*
  Estructura de cuberto.com, medida a 1440: dos columnas con space-between.
  El logo solo a la izquierda; links y boton agrupados juntos a la derecha.
  Los links van pegados entre si —el aire se lo da su padding interno— y
  recien despues aparece la separacion antes del pill.
*/}
<nav class="nav" aria-label="Principal">
  <a href="/" class="brand">
    <img src="/assets/logo_icon.webp" alt="" transition:name="marca-wb" />
    <span>WB Service</span>
  </a>

  <div class="nav-derecha">
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>

    <CtaBoton href="/contacto/" texto="Contacto" clase="cta" />
  </div>

  <button class="ham" aria-label="Menú" id="hamBtn"><span></span><span></span><span></span></button>
</nav>
