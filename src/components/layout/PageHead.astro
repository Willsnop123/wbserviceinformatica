---
interface Props {
  kicker: string;
  titulo: string;
  acento?: string;
  texto: string;
  crumb: string;
}
const { kicker, titulo, acento, texto, crumb } = Astro.props;
---

<nav class="crumbs" aria-label="Migas de pan">
  <a href="/">Inicio</a><span>/</span>{crumb}
</nav>

<header class="page-head">
  <div class="kicker"><span class="bar"></span> {kicker}</div>
  <h1>{titulo}{acento && <><br /><span class="accent">{acento}</span></>}</h1>
  <p>{texto}</p>
</header>
