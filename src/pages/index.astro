---
import WbServiceLayout from '../layouts/WbServiceLayout.astro';
import Portal from '../components/Portal.astro';
import schema from '../data/schema-home.json';
import Hero from '../components/sections/Hero.astro';
import ServiciosGrid from '../components/sections/ServiciosGrid.astro';
import GaleriaCta from '../components/sections/GaleriaCta.astro';
import Resenas from '../components/sections/Resenas.astro';
import Sobre from '../components/sections/Sobre.astro';
import Porque from '../components/sections/Porque.astro';

const title = 'Servicio Técnico PC, PlayStation y Xbox en Gualeguay | WB Service';
const description = 'Reparación de PC, notebooks, PS3, PS4, PS5 y Xbox en Gualeguay, Entre Ríos. Joystick drift y HDMI roto. Diagnóstico sin cargo, turno por WhatsApp.';
const keywords = 'servicio técnico informática Gualeguay, reparación PC Gualeguay, reparación notebook Gualeguay, reparación PlayStation Gualeguay, reparación PS3 PS4 PS5, reparación Xbox Gualeguay, Xbox 360 Xbox One Xbox Series, joystick drift PS4 PS5 Xbox, mantenimiento PC comercios Gualeguay, técnico informático Entre Ríos, WB Service';
---

<WbServiceLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical="https://wbserviceinformatica.com.ar/"
  jsonLd={schema}
  active="inicio"
>
  <Hero />
  <ServiciosGrid />
  <GaleriaCta />
  <Resenas />
  <Sobre />
  <Porque />
  <Portal destino="code" />
</WbServiceLayout>
